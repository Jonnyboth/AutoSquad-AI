{
  "mcpServers": {
    "smartbear-zephyr": {
      "type": "stdio",
      "command": "/usr/local/bin/npx",
      "args": [
        "-y",
        "@smartbear/mcp@latest"
      ],
      "env": {
        "ZEPHYR_API_TOKEN": "${ZEPHYR_API_TOKEN}"
      }
    },
    "com.atlassian/atlassian-mcp-server": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "appium-mcp": {
      "type": "stdio",
      "command": "/usr/local/bin/npx",
      "args": [
        "appium-mcp@latest"
      ],
      "env": {
        "ANDROID_HOME": "${ANDROID_HOME}",
        "CAPABILITIES_CONFIG": ".prompts/super_agent.md",
        "SCREENSHOTS_DIR": "./target/screenshots"
      }
    },
    "playwright-mcp": {
      "type": "stdio",
      "command": "/usr/local/bin/npx",
      "args": [
        "@playwright/mcp@latest",
        "--test-id-attribute",
        "data-qa",
        "--browser",
        "chromium"
      ]
    },
    "aisquare-playwright": {
      "type": "stdio",
      "command": "/usr/local/bin/npx",
      "args": [
        "aisquare-playwright-mcp@latest"
      ]
    }
  }
}
